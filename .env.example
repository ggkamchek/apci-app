# PostgreSQL
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
POSTGRES_PORT=5433

# API
API_PORT=8080
GRPC_PORT=50051
SERVER_ADDR=:8080
GRPC_ADDR=:50051
DATABASE_URL=postgres://platform:platform@localhost:5433/platform?sslmode=disable
CHALLENGE_TTL=60s
SESSION_TTL=24h
MIGRATIONS_DIR=migrations

# Desktop client (local dev, outside Docker)
API_BASE_URL=http://localhost:8080

# Security Center
POSTGRES_SECURITY_PORT=5434
POSTGRES_SECURITY_USER=security
POSTGRES_SECURITY_PASSWORD=security
POSTGRES_SECURITY_DB=security
SECURITY_SERVER_ADDR=:8081
SECURITY_GRPC_ADDR=:50052
SECURITY_ADMIN_PORT=8081
SECURITY_GRPC_PORT=50052
SECURITY_DATABASE_URL=postgres://security:security@localhost:5434/security?sslmode=disable
SECURITY_MIGRATIONS_DIR=migrations
SECURITY_ADMIN_TOKEN=dev-admin-token

# Chat API → Security Center (optional; empty = disabled)
SECURITY_CENTER_ADDR=localhost:50052
